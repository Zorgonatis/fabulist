# Fabulist frontend environment (Vite exposes VITE_* vars via import.meta.env).
# Copy to `.env` or `.env.local` and adjust.

# Base URL of the Fabulist HTTP/SSE API.
VITE_API_BASE=http://localhost:2727

# Set to 1 to serve the scripted in-browser mock instead of calling the backend.
VITE_MOCK=0

# OpenUI lang-core ships an opt-in PostHog telemetry path; keep it off.
# vite.config.ts also forces this on for dev/build/preview.
OPENUI_TELEMETRY_DISABLED=1
