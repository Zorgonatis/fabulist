setlist = Phone("NO ENCORE — band chat", [{from: "Marisol", text: "we are NOT opening with Ghostlight again", time: "20:11", status: "", day: "Fri 14 Mar"}, {from: "You", text: "it's the only one that lands", time: "20:12", status: "read"}, {from: "Dev", text: "it lands because it's the only one we can actually play", time: "20:13", status: ""}, {from: "Priya", text: "rude. true. rude.", time: "20:13", status: "", reactions: [{emoji: "😂", count: 4}]}, {from: "Otis", text: "what if we open with the closer and just go backwards", time: "20:14", status: ""}, {from: "Marisol", text: "Otis.", time: "20:14", status: ""}, {from: "You", text: "i hate that i like it", time: "20:15", status: "delivered", reactions: [{emoji: "💀", count: 2}]}, {from: "Dev", text: "final sheet: ghostlight, tidewall, the long one, tidewall (reprise)", time: "20:16", status: ""}, {from: "Priya", text: "you cannot just call it 'the long one' on the sheet", time: "20:17", status: "", reactions: [{emoji: "📝", count: 1}]}, {from: "Otis", text: "i can physically feel the encore leaving my body", time: "01:40", status: "", day: "Sat 15 Mar", reactions: [{emoji: "🫠"}]}, {from: "Marisol", text: "it is 1:40. go to bed.", time: "01:41", status: ""}, {from: "You", text: "one more thing", time: "01:41", status: "read"}, {from: "Priya", text: "no", time: "01:42", status: "", reactions: [{emoji: "🙅", count: 3}]}, {from: "You", text: "what if the encore is just us standing there in silence", time: "01:43", status: "sent"}, {from: "Dev", text: "...leave it", time: "01:43", status: ""}, {from: "Marisol", text: "put it on the sheet", time: "01:44", status: "", reactions: [{emoji: "🔥", count: 12}]}], {me: "You", typing: "Marisol", clock: "01:45", battery: 62, glyph: "🎸"})
root = ScenePane("Artifact — Phone (16-message max shape)", [setlist])
