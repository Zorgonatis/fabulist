key = Artifact("The Landlady's Key", "Relic", "legendary", "Cut from the door of a house that no longer exists, and it remembers every tenant it ever let in. It has already made up its mind about you.", ["Opens: exactly one door", "Refuses: cops", "Sass: 12", "Charm: +12", "Debt: −3 favours", "Cursed: extremely"], {glyph: "🗝️"})
