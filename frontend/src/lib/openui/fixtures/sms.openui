alert = SMS("banner", "Unknown Number", [{from: "+44 7700 900042", text: "you left the back door of the van open. i closed it. you're welcome.", time: "now", status: ""}], {glyph: "❓"})
thread = SMS("thread", "Unknown Number", [{from: "Unknown Number", text: "you're the one who plays the third song.", time: "22:02", status: "", day: "Fri 14 Mar"}, {from: "You", text: "who is this", time: "22:03", status: "delivered"}, {from: "Unknown Number", text: "doesn't matter. it's a good song. you rush the bridge.", time: "22:03", status: "", reactions: [{emoji: "😐"}]}, {from: "You", text: "how do you know that", time: "22:04", status: "read"}, {from: "Unknown Number", text: "i was at the back. you never look up.", time: "00:17", status: "", day: "Sat 15 Mar"}, {from: "You", text: "stop texting me", time: "00:18", status: "delivered"}, {from: "Unknown Number", text: "goodnight.", time: "00:19", status: "", reactions: [{emoji: "🌙", count: 1}]}], {me: "You"})
root = ScenePane("Artifact — SMS (banner + thread)", [alert, thread])
