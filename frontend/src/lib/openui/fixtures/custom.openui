clean = Custom("Mixtape — Side A", "<div class='mix'><img class='mix-art' src='data:image/svg+xml;base64,' alt='cover art'/><div class='mix-body'><h3 class='mix-title'>Side A — Harbour Static</h3><ol class='tracks'><li class='track'><span class='n'>01</span><span class='t'>Harbour Lights</span><span class='d'>3:12</span></li><li class='track'><span class='n'>02</span><span class='t'>Static Between Stations</span><span class='d'>4:05</span></li><li class='track'><span class='n'>03</span><span class='t'>Low Tide, Late</span><span class='d'>2:48</span></li></ol></div></div>", ".mix{display:flex;gap:.8rem;align-items:flex-start;padding:.9rem;background:var(--bg-panel);color:var(--text);border:1px solid var(--line);border-radius:8px}.mix-art{width:72px;height:72px;border-radius:6px;border:1px solid var(--tone-1-line)}.mix-title{margin:0 0 .4rem;color:var(--tone-1);font-size:15px;letter-spacing:.04em}.tracks{margin:0;padding:0;list-style:none}.track{display:flex;gap:.6rem;font-size:14px;padding:.15rem 0}.n{color:var(--tone-2)}.d{margin-left:auto;color:var(--text-muted)}.outside-probe{color:hsl(300 100% 50%)!important}", {glyph: "📼"})
poster = Custom("NEON REQUIEM", "<div class='poster'><em class='kicker'>now playing</em><strong class='name'>NEON<br/>REQUIEM</strong><span class='tag'>one last song for the drowned city</span></div>", ".poster{display:flex;flex-direction:column;gap:.3rem;padding:1.1rem;background:var(--bg-inset);border:1px solid var(--tone-1-line);border-radius:6px;text-align:center}.kicker{font-size:14px;letter-spacing:.3em;text-transform:uppercase;color:var(--tone-2)}.name{font-size:22px;line-height:1.05;color:var(--tone-1);letter-spacing:.05em}.tag{font-size:14px;color:var(--text-muted)}")
hostile = Custom("untrusted", "<div class='xss'><style>.xss{display:none}</style><script>window.__pwned=1</script><img src='http://evil.example/track.png' onerror='window.__pwned=1'><p class='survivor'>this line survives sanitizing</p><a href='javascript:window.__pwned=1'>click</a><span class='inline-style' style='background:url(http://evil.example/inline.png)'>styled</span></div>", "@import url('http://evil.example/x.css');.xss{background:url('http://evil.example/bg.png')}.xss p{color:var(--tone-1)}")
root = ScenePane("Custom — the escape hatch", [clean, poster, hostile])
