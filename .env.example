# Fabulist — example environment file. Copy to `.env` beside docker-compose.yml
# (a fresh clone has none) and uncomment what you need.
#
# Compose reads this file twice: as `${...}` interpolation for
# docker-compose.yml itself (sidecar settings below), and as the ENGINE's
# container environment (`env_file`), which is where API keys belong.
# `.env` is gitignored. Never put a real key in this example.

# --- Models sidecar (read by docker-compose.yml) -----------------------------

# Which Vulkan device the sidecar's llama.cpp router uses. Vulkan enumerates in
# its own order (index 0 is not necessarily your first card) and the entrypoint
# refuses to guess when several GPUs are visible. Set ONE of the two; leave both
# empty on a host with exactly one visible device.
#FABULIST_SIDECAR_DEVICE=Vulkan0
#FABULIST_SIDECAR_DEVICE_MATCH=RTX 5090

# Host directory mounted read-only at /models. Only needed for the
# local-weights override: the shipped preset fetches the three models from
# HuggingFace on their first request, so no models directory is required.
# If you do use it, create it yourself before the first `docker compose up` —
# Docker would create a missing directory root-owned.
#FABULIST_MODELS_DIR=./models

# Host path of the router preset, mounted at /etc/fabulist/models.ini. The
# default is the shipped preset (HuggingFace refs). Point it at your own copy
# only for the local-weights override, where sections name /models/... paths.
#FABULIST_SIDECAR_PRESET=./deploy/sidecar/models.ini

# HuggingFace token. NOT needed: all three shipped repos are ungated and fetched
# anonymously. llama.cpp reads HF_TOKEN natively, so this is the only knob a
# gated repo would ever require. Empty sends no Authorization header.
#HF_TOKEN=

# Host loopback port for the sidecar (published as 127.0.0.1:<port>). The
# default is 8445 because 4445 is the conventional port for an existing host
# model server.
#FABULIST_SIDECAR_PORT=8445

# --- API keys (read by the engine) -------------------------------------------
#
# A connection names the ENVIRONMENT VARIABLE, never the key:
#   "api_key_env": "FABULIST_DEEPSEEK_KEY"
# and the engine reads that variable from its environment (this file, passed in
# by the compose `env_file`). Pasting a key in the Connections drawer writes the
# same line as FABULIST_<CONNECTION_NAME>_KEY — uppercased, every
# non-alphanumeric character replaced by `_`.
#
# Nothing maps a key to a provider. The name says nothing about the endpoint;
# base_url and model id are chosen in the connection. Known-good pairings:
#
# DeepSeek — models `deepseek-flash` and `deepseek-v4-pro`,
# base_url https://api.deepseek.com/v1
#FABULIST_DEEPSEEK_KEY=
#
# z.ai GLM — model `glm-5.3`, base_url https://api.z.ai/api/coding/paas/v4
# (api.z.ai is canonical; open.bigmodel.cn serves the same model list if that is
# where you are billed)
#FABULIST_GLM_KEY=
